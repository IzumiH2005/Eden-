+            if i % 20 == 0: print(f"progress {i} {total} extract", flush=True)
+        chunks = install_chunks(src); tocd = {}
+        for t, bi in sorted(hit):
+            if t not in tocd: tocd[t] = toc_bundles(src.read(t), t)
