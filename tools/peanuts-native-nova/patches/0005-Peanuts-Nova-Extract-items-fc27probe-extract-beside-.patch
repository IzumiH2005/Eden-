-                        nm.notify(NOTE, note(name, "Lecture des archives : " + d + " / " + t + " bundles", (int) (100 * d / t)));
-                        writeStatus(this, "running", d, t, "Lecture des archives du jeu : " + d + " / " + t + " bundles");
+                        boolean ex = p.length > 3 && p[3].equals("extract");
