+                        nm.notify(NOTE, note(name, what, (int) (100 * d / t)));
+                        writeStatus(this, "running", d, t, what);
                     }
                 }
             } catch (InterruptedException e) { return; } catch (IOException | RuntimeException ignored) { /* the next second tries again */ }
