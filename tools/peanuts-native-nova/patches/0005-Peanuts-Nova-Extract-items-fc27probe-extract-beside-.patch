+    /** NOVA: "Extract items": the ebx / res whose name matches a regular expression (prefilled from Download/PeanutsNova-modding/extract.txt, else the default),
+     *  with the chunks and manifest of their bundles, into a zip in Download/PeanutsNova-modding (ModAnalysisService, fc27probe extract) */
+    public static void novaExtract(android.app.Activity a, File nup, String titleId, String name) {
+        String rx = NOVA_EXTRACT_RX;
+        try {
+            File f = new File(ModAnalysisService.outDir(), "extract.txt");
+            if (f.isFile()) { String t = new String(java.nio.file.Files.readAllBytes(f.toPath()), java.nio.charset.StandardCharsets.UTF_8).trim(); if (!t.isEmpty()) rx = t; }
+        } catch (java.io.IOException | RuntimeException ignored) { /* the default */ }
+        int pad = (int) (20 * a.getResources().getDisplayMetrics().density);
+        LinearLayout box = new LinearLayout(a); box.setOrientation(LinearLayout.VERTICAL); box.setPadding(pad, pad / 2, pad, 0);
+        TextView text = new TextView(a);
+        text.setText("Copie hors du jeu les éléments dont le nom correspond à cette expression, avec les chunks et le manifeste de leurs bundles, et les fichiers dont le chemin correspond (Data/…, Patch/…). "
+                + "Utilise l'index de la dernière analyse (sinon le jeu est d'abord lu en entier). Le résultat est un zip dans Download/PeanutsNova-modding, à envoyer.");
+        android.widget.EditText edit = new android.widget.EditText(a);
+        edit.setText(rx); edit.setTextSize(12); edit.setMaxLines(6); edit.setSingleLine(false);
+        box.addView(text); box.addView(edit);
+        AlertDialog dlg = new AlertDialog.Builder(a).setTitle("Extraire des éléments du jeu").setView(box)
+                .setPositiveButton("Extraire", (d, w) -> {
+                    String r = edit.getText().toString().trim();
+                    try { java.util.regex.Pattern.compile(r); } catch (RuntimeException e) {
+                        android.widget.Toast.makeText(a, "Expression invalide : " + e.getMessage(), android.widget.Toast.LENGTH_LONG).show(); return;
+                    }
+                    if (android.os.Build.VERSION.SDK_INT >= 33 && a.checkSelfPermission(android.Manifest.permission.POST_NOTIFICATIONS) != android.content.pm.PackageManager.PERMISSION_GRANTED)
+                        a.requestPermissions(new String[] {android.Manifest.permission.POST_NOTIFICATIONS}, 7301);
+                    boolean started = ModAnalysisService.start(a, nup, titleId, name, r);
+                    if (!started) android.widget.Toast.makeText(a, "Un travail est déjà en cours : voici son avancement", android.widget.Toast.LENGTH_LONG).show();
+                    novaProgress(a);
+                })
+                .setNeutralButton("Par défaut", null)
+                .setNegativeButton("Annuler", null).create();
+        dlg.setOnShowListener(x -> dlg.getButton(AlertDialog.BUTTON_NEUTRAL).setOnClickListener(v -> edit.setText(NOVA_EXTRACT_RX)));   // stays open
+        dlg.show();
+    }
