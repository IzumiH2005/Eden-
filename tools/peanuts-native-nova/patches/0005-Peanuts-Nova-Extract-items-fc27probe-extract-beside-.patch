+    /** NOVA: the default of Extract: the faces the converted PC face pack replaces (textures), one player's whole head (Bukayo Saka), and the small cas file the converted mod adds its data to */
+    static final String NOVA_EXTRACT_RX = "^Patch/NX/superbundlelayout/commentaryfull_eng_us/cas_01\\.cas$|bukayo_saka_246669/|/(ilkay_gundogan_186942|romelu_lukaku_192505|inigo_martinez_204525|joao_cancelo_210514|aymeric_laporte_212218|bruno_fernandes_212198|youri_tielemans_216393|james_maddison_220697|martin_odegaard_222665|frenkie_dejong_228702|lautaro_martinez_231478|marcus_rashford_231677|raphael_diasbelloli_233419|declan_rice_234378|achraf_hakimi_235212|morgan_gibbswhite_236015|noussair_mazraoui_236401|dominik_szoboszlai_236772|reece_james_238074|vinicius_junior_238794|alexis_macallister_239837|jules_kounde_241486|dani_olmocarvajal_244260|eric_garciamartret_245037|xavi_simons_245367|julian_alvarez_246191|mykhailo_mudryk_246340|bukayo_saka_246669|cherki_rayan_251570|pedri_gonzalez_251854|jude_bellingham_252371|jeremie_frimpong_253149|elliot_anderson_254243|noni_madueke_254796|christos_tzolis_256948|riccardo_calafiori_257711|ismael_saibari_259480|benjamin_sesko_260592|gavi_264240|cher_ndour_276682|lopez_marin_fermin_277179|lamine_yamal_277643|ayyoub_bouaddi_278901)/var_0/(face|hair)_\\d+_0_0_(color|normal|specmask|coeff)$";
