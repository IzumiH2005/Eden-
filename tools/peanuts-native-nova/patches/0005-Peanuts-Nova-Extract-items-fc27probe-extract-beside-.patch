+    /** fc27probe extract into the analysis's own folder (its index.tsv.gz kept from the last analysis; made first when missing), items.zip out to Download */
+    private void extract(File nup, String title, String name, String rx) {
+        String stamp = new SimpleDateFormat("yyyyMMdd-HHmmss", Locale.ROOT).format(new Date());
+        File work = new File(getCacheDir(), "mod-analysis"), log = new File(work, "extract.log");
+        boolean ok = false; String msg;
+        try {
+            if (!work.isDirectory() && !work.mkdirs()) throw new IOException("cannot make " + work);
+            new File(work, "items.zip").delete(); log.delete();
+            if (!log.createNewFile()) throw new IOException("cannot make " + log);
+            PackNative.context(this);
+            writeStatus(this, "running", 0, 0, new File(work, "index.tsv.gz").isFile() ? "Recherche des éléments dans l'index…"
+                    : "Pas encore d'index : lecture des archives du jeu d'abord…");
+            final boolean[] done = {false};
+            Thread watch = new Thread(() -> watch(log, name, done), "nova-mod-analysis-progress");
+            watch.start();
+            int code = PackNative.packRun("dm/tools/fc27probe.py", new String[] {"extract", nup.getPath(), work.getPath(), rx}, log.getPath());
+            done[0] = true;
+            File zip = new File(work, "items.zip");
+            if (code != 0 || !zip.isFile()) throw new IOException("the extraction stopped (code " + code + "): " + tail(log));
+            File dir = outDir();
+            if (!dir.isDirectory() && !dir.mkdirs()) throw new IOException("cannot make " + dir);
+            File to = new File(dir, title + "-items-" + stamp + ".zip");
+            Files.copy(zip.toPath(), to.toPath(), StandardCopyOption.REPLACE_EXISTING);
+            Files.copy(log.toPath(), new File(dir, title + "-items-" + stamp + ".log").toPath(), StandardCopyOption.REPLACE_EXISTING);
+            ok = true;
+            msg = "Terminé : Download/PeanutsNova-modding/" + to.getName() + " (" + Math.max(1, to.length() >> 20) + " Mo). Envoie ce fichier.";
+            writeStatus(this, "done", 1, 1, msg);
+        } catch (IOException | RuntimeException | LinkageError e) {
+            Log.e(TAG, "extraction failed", e);
+            msg = "Échec : " + e.getMessage() + " (le .log est dans Download/PeanutsNova-modding)";
+            writeStatus(this, "failed", 0, 0, msg);
+            try {
+                File dir = outDir(); dir.mkdirs();
+                if (log.isFile()) Files.copy(log.toPath(), new File(dir, title + "-items-" + stamp + "-failed.log").toPath(), StandardCopyOption.REPLACE_EXISTING);
+            } catch (IOException | RuntimeException ignored) { /* the notification says it */ }
+        }
+        stopForeground(STOP_FOREGROUND_DETACH);
+        nm.notify(NOTE + 1, new Notification.Builder(this, CHANNEL).setSmallIcon(ok ? android.R.drawable.stat_sys_download_done : android.R.drawable.stat_notify_error)
+                .setContentTitle((ok ? "Extraction: " : "Extraction failed: ") + name).setContentText(msg)
+                .setStyle(new Notification.BigTextStyle().bigText(msg)).setAutoCancel(true).build());
+        running = false;
+        stopSelf();
+    }
+
     /** Follows the tool's "progress <done> <total> <stage>" lines into the notification */
     private void watch(File log, String name, boolean[] done) {
         long pos = 0;
@@ -139,8 +188,10 @@ public final class ModAnalysisService extends Service {
                     if (last != null) {
