@@ -1565,17 +1569,60 @@ public final class MainActivity extends Activity {
     void novaAnalyse(File nup, String titleId, String name) { novaAnalyse(this, nup, titleId, name); }
 
     public static void novaAnalyse(android.app.Activity a, File nup, String titleId, String name) {
+        String[] cur = ModAnalysisService.readStatus(a);
+        if (cur != null && (cur[0].equals("running") || cur[0].equals("starting")) && ModAnalysisService.statusFile(a).lastModified() > System.currentTimeMillis() - 30_000) {
+            novaProgress(a);   // one runs: its progress, not a second one
+            return;
+        }
         new AlertDialog.Builder(a).setTitle("Analyser pour le modding")
                 .setMessage("Lit les archives de " + name + " directement dans son .nup, sur tous les cœurs du téléphone : la liste des fichiers, les tables "
                         + "des archives et le contenu de chaque bundle (maillots, visages, textures…). Rien n'est modifié.\n\nDurée : de quelques minutes à "
                         + "un quart d'heure. Une notification suit l'avancement ; le résultat est un zip dans Download/PeanutsNova-modding, à envoyer.")
                 .setPositiveButton("Lancer", (d, w) -> {
-                    boolean ok = ModAnalysisService.start(a, nup, titleId, name);
-                    android.widget.Toast.makeText(a, ok ? "Analyse lancée : suis la notification" : "Une analyse est déjà en cours", android.widget.Toast.LENGTH_LONG).show();
+                    if (android.os.Build.VERSION.SDK_INT >= 33 && a.checkSelfPermission(android.Manifest.permission.POST_NOTIFICATIONS) != android.content.pm.PackageManager.PERMISSION_GRANTED)
+                        a.requestPermissions(new String[] {android.Manifest.permission.POST_NOTIFICATIONS}, 7301);
+                    boolean started = ModAnalysisService.start(a, nup, titleId, name);
