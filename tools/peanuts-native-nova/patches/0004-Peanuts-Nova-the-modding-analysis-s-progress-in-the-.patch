+                    novaProgress(a);
                 })
                 .setNegativeButton("Annuler", null).show();
     }
 
+    /** NOVA: the analysis's progress in the app (ModAnalysisService's status file, read every second while the window is open) */
+    public static void novaProgress(android.app.Activity a) {
+        int pad = (int) (20 * a.getResources().getDisplayMetrics().density);
+        LinearLayout box = new LinearLayout(a); box.setOrientation(LinearLayout.VERTICAL); box.setPadding(pad, pad / 2, pad, 0);
+        TextView text = new TextView(a); text.setText("Démarrage…");
+        android.widget.ProgressBar bar = new android.widget.ProgressBar(a, null, android.R.attr.progressBarStyleHorizontal);
+        bar.setIndeterminate(true); bar.setMax(1000);
+        TextView sub = new TextView(a); sub.setTextSize(12); sub.setAlpha(0.7f);
+        box.addView(text); box.addView(bar); box.addView(sub);
+        AlertDialog dlg = new AlertDialog.Builder(a).setTitle("Analyse pour le modding").setView(box)
+                .setPositiveButton("Fermer", null).setCancelable(true).create();
+        android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
+        long t0 = System.currentTimeMillis();
+        Runnable tick = new Runnable() { public void run() {
+            if (!dlg.isShowing()) return;
+            String[] st = ModAnalysisService.readStatus(a);
+            if (st == null) { text.setText("En attente du moteur d'analyse…"); }
+            else {
+                long d = 0, t = 0; try { d = Long.parseLong(st[1]); t = Long.parseLong(st[2]); } catch (NumberFormatException ignored) { }
+                text.setText(st[3]);
+                boolean end = st[0].equals("done") || st[0].equals("failed");
+                bar.setIndeterminate(!end && t <= 0);
+                if (end) bar.setProgress(st[0].equals("done") ? 1000 : 0); else if (t > 0) bar.setProgress((int) (1000 * d / t));
+                long age = (System.currentTimeMillis() - ModAnalysisService.statusFile(a).lastModified()) / 1000;
+                sub.setText(end ? (st[0].equals("done") ? "Fini." : "Arrêté.")
+                        : age > 60 ? "Aucune nouvelle depuis " + age + " s : le moteur s'est peut-être arrêté. Envoie une capture de cette fenêtre."
+                        : "En cours depuis " + (System.currentTimeMillis() - t0) / 1000 + " s · dernière nouvelle il y a " + age + " s. Tu peux fermer cette fenêtre : l'analyse continue.");
+                if (end) return;
+            }
+            h.postDelayed(this, 1000);
+        } };
+        dlg.setOnShowListener(x -> h.post(tick));
+        dlg.show();
+    }
+
