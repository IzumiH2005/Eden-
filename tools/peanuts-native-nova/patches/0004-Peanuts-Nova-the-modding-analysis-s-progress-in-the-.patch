diff --git a/android/app/src/ondevice/java/dev/nxnative/android/ModAnalysisService.java b/android/app/src/ondevice/java/dev/nxnative/android/ModAnalysisService.java
index 910814df..a8dc711c 100644
--- a/android/app/src/ondevice/java/dev/nxnative/android/ModAnalysisService.java
+++ b/android/app/src/ondevice/java/dev/nxnative/android/ModAnalysisService.java
@@ -35,11 +35,31 @@ public final class ModAnalysisService extends Service {
     /** Starts the analysis of nup (a game's .nup file) for title ID titleId named name; false when one already runs */
     public static boolean start(Context c, File nup, String titleId, String name) {
         if (running) return false;
+        String[] st = readStatus(c);
+        if (st != null && (st[0].equals("running") || st[0].equals("starting")) && statusFile(c).lastModified() > System.currentTimeMillis() - 30_000) return false;
+        writeStatus(c, "starting", 0, 0, "Démarrage du moteur d'analyse…");
         Intent i = new Intent(c, ModAnalysisService.class).putExtra(EXTRA_NUP, nup.getPath()).putExtra(EXTRA_TITLE, titleId).putExtra(EXTRA_NAME, name);
         c.startForegroundService(i);
         return true;
     }
 
+    /** The analysis's state for the app's own window (another process): one line "state\tdone\ttotal\tmessage", state starting / running / done / failed */
+    public static File statusFile(Context c) { return new File(c.getFilesDir(), "mod-analysis-status.txt"); }
+
+    public static void writeStatus(Context c, String state, long done, long total, String message) {
+        try {
+            File f = statusFile(c), tmp = new File(f.getPath() + ".tmp");
+            Files.write(tmp.toPath(), (state + "\t" + done + "\t" + total + "\t" + message.replace('\n', ' ').replace('\t', ' ')).getBytes(java.nio.charset.StandardCharsets.UTF_8));
+            if (!tmp.renameTo(f)) Files.copy(tmp.toPath(), f.toPath(), StandardCopyOption.REPLACE_EXISTING);
+        } catch (IOException | RuntimeException e) { Log.w(TAG, "status: " + e); }
+    }
+
+    /** [state, done, total, message] as last written, or null */
+    public static String[] readStatus(Context c) {
+        try { String[] p = new String(Files.readAllBytes(statusFile(c).toPath()), java.nio.charset.StandardCharsets.UTF_8).split("\t", 4); return p.length == 4 ? p : null; }
+        catch (IOException | RuntimeException e) { return null; }
+    }
+
     public static File outDir() { return new File(Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS), "PeanutsNova-modding"); }
 
     private NotificationManager nm;
