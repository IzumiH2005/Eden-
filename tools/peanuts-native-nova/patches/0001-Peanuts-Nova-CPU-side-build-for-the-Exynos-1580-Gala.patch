+++ b/android/app/src/main/java/dev/nxnative/android/Prefs.java
@@ -52,8 +52,9 @@ final class Prefs {
     static void rumbleDefault(Context c, boolean on) { of(c).edit().putBoolean("rumble", on).commit(); }
     static boolean rumble(Context c, String titleId) { return of(c).getBoolean(gameKey("rumble", titleId), rumble(c)); }
     static void rumble(Context c, String titleId, boolean on) { of(c).edit().putBoolean(gameKey("rumble", titleId), on).commit(); }
-    /** Use fast cores (Native.pinThreads): the main screen's default (off: not measured yet, and it may work against the ADPF hint session of vka_perf.c), then each game's own */
-    static boolean pinThreads(Context c) { return of(c).getBoolean("pin_threads", false); }
+    /** Use fast cores (Native.pinThreads): the main screen's default, then each game's own. NOVA: on by default (upstream: off, not measured yet, and it may work against the
+     *  ADPF hint session of vka_perf.c): the replay thread, the most work a frame on one thread, then keeps the fastest core to itself instead of the scheduler moving it */
+    static boolean pinThreads(Context c) { return of(c).getBoolean("pin_threads", true); }
     static void pinThreadsDefault(Context c, boolean on) { of(c).edit().putBoolean("pin_threads", on).commit(); }
     static boolean pinThreads(Context c, String titleId) { return of(c).getBoolean(gameKey("pin_threads", titleId), pinThreads(c)); }
     static void pinThreads(Context c, String titleId, boolean on) { of(c).edit().putBoolean(gameKey("pin_threads", titleId), on).commit(); }
diff --git a/android/app/src/main/java/dev/peanuts/ui/DeviceStats.java b/android/app/src/main/java/dev/peanuts/ui/DeviceStats.java
index 7e81247d..84395d08 100644
--- a/android/app/src/main/java/dev/peanuts/ui/DeviceStats.java
+++ b/android/app/src/main/java/dev/peanuts/ui/DeviceStats.java
@@ -102,9 +102,15 @@ public final class DeviceStats {
         if (ps == null) return null;
         List<File> list = new ArrayList<>();
         for (File p : ps) if (readLong(new File(p, "cpuinfo_max_freq")) > 0) list.add(p);
+        // NOVA: among the policies at 75 % of the top clock or more first (as Overlay.findClusters): on a 1 + 3 + 4 CPU the most cores are the small ones
+        long top = 0; for (File p : list) top = Math.max(top, readLong(new File(p, "cpuinfo_max_freq")));
+        final long t = top;
         list.sort((a, b) -> {
+            long ma = readLong(new File(a, "cpuinfo_max_freq")), mb = readLong(new File(b, "cpuinfo_max_freq"));
+            boolean ba = ma * 4 >= t * 3, bb = mb * 4 >= t * 3;
+            if (ba != bb) return ba ? -1 : 1;
             int ca = cores(a), cb = cores(b);
-            return ca != cb ? cb - ca : Long.compare(readLong(new File(a, "cpuinfo_max_freq")), readLong(new File(b, "cpuinfo_max_freq")));
+            return ca != cb ? cb - ca : Long.compare(ma, mb);
         });
         main = list.isEmpty() ? null : list.get(0);
         return main;
