 dm/gfx/vk_android/vka_dev.c                              | 3 ++-
 dm/gfx/vk_android/vka_draw.c                             | 4 +++-
 dm/gfx/vk_android/vka_pso.c                              | 3 ++-
 dm/host/tests/t_android_auto.c                           | 5 +++++
 docs/advanced_settings.tsv                               | 4 ++--
 docs/env_switches.tsv                                    | 4 ++--
 13 files changed, 46 insertions(+), 19 deletions(-)

diff --git a/android/app/build.gradle b/android/app/build.gradle
index 8073e249..1468b19a 100644
--- a/android/app/build.gradle
+++ b/android/app/build.gradle
@@ -56,6 +56,8 @@ def peanutsVersionFile = file('../../peanuts/VERSION')
 def peanutsVersion = providers.gradleProperty('nxVersion').getOrElse(peanutsVersionFile.isFile() ? peanutsVersionFile.text.trim() : '0.0.0')
 def nxPeanutsId = nxApp == 'peanuts' ? "peanuts-native-${peanutsVersion}" + (nxRelease ? '' : '-dev') : ''
 // Lossless Scaling frame generation (GPL-3.0-or-later, dm/gfx/vk_android/lsfg): in by default, which makes the APK GPL-3.0-or-later; -PnxLsfg=false builds without it (the packer's libdmsh_xlate.so is GPL-3.0-or-later too: android/NOTICE.md)
+// NOVA: -PnxCpu=<cpu> (e.g. cortex-a720+nosve) compiles every native library of the APK for that CPU (-mcpu); unset, the NDK's generic armv8-a
+def nxCpu = providers.gradleProperty('nxCpu').getOrElse('')
 def nxLsfg = providers.gradleProperty('nxLsfg').getOrElse('true') != 'false'
 // Preparing the game on the phone (android/ONDEVICE.md): "+ Add game" on a dump without a usable pack offers Prepare, which runs PackService (a foreground service
 // in :pack) with the embedded packer: CPython 3.14 with the repository's tools, the translator (libdmsh_xlate.so) and SPIRV-Tools (libSPIRV-Tools-shared.so). Part of
@@ -371,6 +373,7 @@ android {
             cmake {
                 // PEANUTS: -PnxGenericHost=true builds one libnxhost.so/libnxlaunch.so that loads any of nxGames' profiles at
                 // run time, instead of a compiled-in pair per title - gated here, not on by default, so the per-title path (today's APK) stays available.
+                if (nxCpu) { cFlags "-mcpu=$nxCpu"; cppFlags "-mcpu=$nxCpu" }   // NOVA
                 if (nxGenericHost) {
                     arguments '-DNX_GENERIC_HOST=ON', '-DANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES=ON', "-DNX_LSFG=${nxLsfg ? 'ON' : 'OFF'}"
                     targets(*(['nxhost', 'nxlaunch', 'nxadreno', 'hook_impl', 'main_hook'] + (nxApp == 'peanuts' ? ['nximport'] : [])))
diff --git a/android/app/src/main/java/dev/nxnative/android/Overlay.java b/android/app/src/main/java/dev/nxnative/android/Overlay.java
index 463f4024..1ad22a1d 100644
--- a/android/app/src/main/java/dev/nxnative/android/Overlay.java
+++ b/android/app/src/main/java/dev/nxnative/android/Overlay.java
@@ -144,7 +144,14 @@ final class Overlay {
             catch (IOException | RuntimeException e) { k.cores = 1; }
             if (k.maxKHz > 0) clusters.add(k);
         }
-        clusters.sort((a, b) -> a.cores != b.cores ? b.cores - a.cores : Long.compare(a.maxKHz, b.maxKHz));
+        // NOVA: the main cluster among those at 75 % of the top clock or more (the cores nxlaunch.c pinThreads gives the game), else among all: on a 1 + 3 + 4 CPU
+        // (Exynos 1580: 1 x 2.9, 3 x 2.6, 4 x 1.95 GHz) the policy with the most cores was the small cores', whose cap says nothing of the game's
+        long top = 0; for (Cluster k : clusters) top = Math.max(top, k.maxKHz);
+        final long t = top;
+        clusters.sort((a, b) -> {
+            boolean ba = a.maxKHz * 4 >= t * 3, bb = b.maxKHz * 4 >= t * 3;
+            return ba != bb ? (ba ? -1 : 1) : a.cores != b.cores ? b.cores - a.cores : Long.compare(a.maxKHz, b.maxKHz);
+        });
     }
 
     private void readCpu() {
