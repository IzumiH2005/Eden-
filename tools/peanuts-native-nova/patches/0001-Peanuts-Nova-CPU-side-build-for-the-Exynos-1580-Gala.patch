 .../app/src/main/java/dev/nxnative/android/Overlay.java  | 9 ++++++++-
 .../app/src/main/java/dev/nxnative/android/Prefs.java    | 5 +++--
 .../app/src/main/java/dev/peanuts/ui/DeviceStats.java    | 8 +++++++-
